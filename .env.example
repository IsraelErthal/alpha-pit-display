# Copy this file to .env before running `docker compose up --build` — Compose
# reads .env both to fill in the ${VAR} placeholders in docker-compose.yml and,
# for the backend service, as the env_file passed straight into the container.

# --- backend runtime (docker-compose.yml: services.backend.env_file) --------
# Also used by src/config/env.js when running the backend outside Docker.
DATABASE_URL=mysql://user:password@host:3306/alpha_pit_display
PORT=3000
CLIENT_ORIGIN=http://localhost:8080
FIREBASE_PROJECT_ID=

# Set to "true" to run `prisma migrate deploy` automatically on container start
# (docker-entrypoint.sh).
RUN_MIGRATIONS=false

# Path (inside the container) to a Firebase service account JSON, only needed if
# Application Default Credentials aren't otherwise available to firebase-admin.
# Requires uncommenting the matching volume mount in docker-compose.yml.
# GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# --- frontend build args (docker-compose.yml: services.frontend.build.args) -
# Vite inlines these into the JS bundle at image build time, so they must be
# set here *before* `docker compose build`, not just at container start.
# Mirrors frontend/.env.example, used for local `npm run dev` instead.
VITE_API_URL=http://localhost:3000
VITE_YOUTUBE_VIDEO_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
