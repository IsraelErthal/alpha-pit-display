generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Comentario {
  id         Int      @id @default(autoincrement())
  mensagem   String   @db.Text
  status     String   @default("pendente")
  criado_em  DateTime @default(now())
  ocultado_em DateTime?
  autor      String   @default("Torcedor Alpha")
  pais       String   @default("BR") @db.VarChar(2)

  @@map("comentarios")
  @@index([status, criado_em])
}

model AcessoLog {
  id               Int      @id @default(autoincrement())
  data_hora_acesso DateTime @default(now())
  sessao_id        String   @db.VarChar(64)

  @@map("acessos_log")
  @@index([data_hora_acesso])
  @@index([sessao_id, data_hora_acesso])
}