generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Comentario {
  id         Int      @id @default(autoincrement())
  mensagem   String   @db.Text
  status     String   @default("pendente")
  criado_em  DateTime @default(now())
  ocultado_em DateTime?
  autor      String   @default("Torcedor Alpha")
  autor_uid  String?  @db.VarChar(128)
  termos_aceitos_em DateTime?
  pais       String   @default("BR") @db.VarChar(2)

  @@map("comentarios")
  @@index([status, criado_em])
  @@index([autor_uid])
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(190)
  senha_hash String   @db.VarChar(255)
  criado_em  DateTime @default(now())

  @@map("admin_users")
}

model AcessoLog {
  id               Int      @id @default(autoincrement())
  data_hora_acesso DateTime @default(now())
  sessao_id        String   @db.VarChar(64)

  @@map("acessos_log")
  @@index([data_hora_acesso])
  @@index([sessao_id, data_hora_acesso])
}
